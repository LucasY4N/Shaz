# ─── Shaz AI - Configuração de Ambiente ──────────────────────────────────
# Copie este arquivo para .env e preencha suas chaves de API.
# No mínimo UMA chave de API de LLM é necessária.

# ─── LLM Providers (pelo menos um é necessário) ──────────────────────────

# OpenAI
OPENAI_API_KEY="sua-chave-openai-aqui"

# OpenRouter (acesso a vários modelos via uma API)
OPENROUTER_API_KEY="sua-chave-openrouter-aqui"

# Groq (LPU Inference - gratuito para alguns modelos)
GROQ_API_KEY="sua-chave-groq-aqui"

# Google Gemini
GEMINI_API_KEY="sua-chave-gemini-aqui"

# Ollama (local - não precisa de chave)
OLLAMA_BASE_URL="http://localhost:11434"

# ─── Configurações Adicionais (opcional) ─────────────────────────────────

# Nível de log: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL="INFO"

# Ambiente: development, production
ENVIRONMENT="development"