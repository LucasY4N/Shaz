# ─── Shaz AI — .env.example ───────────────────────────────────────────────
# Copie para .env e preencha suas chaves.
# Pelo menos UMA chave de LLM é obrigatória.

# ─── LLM (mínimo 1) ──────────────────────────────────────────────────────
GEMINI_API_KEY=""
GROQ_API_KEY=""
OPENAI_API_KEY=""
OPENROUTER_API_KEY=""
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_MODEL="llama3.2:latest"

# ─── APIs Externas (opcionais) ────────────────────────────────────────────
GITHUB_TOKEN=""               # github.com → Settings → Developer settings → Personal access tokens
OPENWEATHER_API_KEY=""        # openweathermap.org → API keys
TAVILY_API_KEY=""             # app.tavily.com → API keys

# ─── Database ─────────────────────────────────────────────────────────────
MONGODB_URI="mongodb://localhost:27017"
MONGODB_DB="shaz_ai"
SQLITE_PATH="data/memory.db"

# ─── Servidor ─────────────────────────────────────────────────────────────
SERVER_HOST="127.0.0.1"
SERVER_PORT=8765
ENVIRONMENT="development"      # development | production | testing
LOG_LEVEL="INFO"               # DEBUG | INFO | WARNING | ERROR | CRITICAL

# ─── Voz (opcional) ──────────────────────────────────────────────────────
TTS_ENGINE="edge"
TTS_VOICE="pt-BR-FranciscaNeural"
STT_ENGINE="whisper"
STT_MODEL="base"
ELEVENLABS_API_KEY=""

# ─── Segurança (mudar em produção) ───────────────────────────────────────
SECRET_KEY="changeme-in-production"
